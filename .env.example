# ═══════════════════════════════════════════════════════════════════════════
#  AI PROVIDER API KEYS — paste your keys here, then restart the server.
#  Keys are read only from this file: never stored in the database, never sent to the browser.
# ═══════════════════════════════════════════════════════════════════════════
# OpenAI:           https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google Gemini:    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Model IDs (required per provider; can also be set/overridden in AI Model Settings) ──
# No defaults are built in: use the model ID from your provider's documentation.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Provider used for chat until you pick one in AI Model Settings: openai | anthropic | gemini
DEFAULT_AI_PROVIDER=openai

# ── Knowledge layer tuning (optional) ──────────────────────────────────────
# Local Hugging Face (ONNX) embedding model. Changing it requires re-uploading documents.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_POOLING=cls
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.5
MAX_UPLOAD_MB=20
DATA_DIR=./data

# ── OCR for scanned PDFs (optional) ────────────────────────────────────────
# Pages without a text layer are read with local Tesseract OCR (nothing is sent to a cloud service).
# The language data downloads once on first use into DATA_DIR/models/tessdata.
OCR_ENABLED=true
# Tesseract language codes joined with "+", e.g. eng or eng+hin+guj
OCR_LANGUAGES=eng
# Most pages OCR'd per document; longer scans are refused (split them into parts).
OCR_MAX_PAGES=300
# Pages recognized in parallel; empty = scales with the CPU (max 4).
OCR_WORKERS=

# ── Voice (optional; uses GEMINI_API_KEY) ───────────────────────────────────
# "Listen" on answers: Gemini text-to-speech, generated only when the user clicks Listen.
GEMINI_TTS_ENABLED=true
# Models: https://ai.google.dev/gemini-api/docs/speech-generation (e.g. gemini-3.8-flash-lite-tts, gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Prebuilt voice: Kore, Puck, Charon, Aoede, Fenrir, Leda, …
GEMINI_TTS_VOICE=Kore
TTS_MAX_CHARS=5000
# Microphone input: speech is transcribed into the chat box (never sent automatically).
VOICE_INPUT_ENABLED=true
# Model used for transcription; empty = the Gemini chat model (GEMINI_MODEL).
GEMINI_STT_MODEL=

# ── Doctor consultations (recording → transcript → clinical note) — HEALTH INFORMATION ──────────────
# Nothing here is on by default. Three separate things have to be done before a recording can reach an AI service:
#   1. the key below (seals patient names, transcripts, notes and the stored audio),
#   2. a provider, a model and a recorded REVIEW of that provider's data handling (who checked, when, and where it is processed),
#   3. a platform administrator switching "Doctor Consultations" on in Settings → Feature Management.
# Until 2 is complete, recordings are accepted and kept (sealed, on this server) but NOTHING is sent anywhere.
# Generate the key once and keep it safe and the same for ever (losing it makes stored consultations unreadable):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONSULTATIONS_ENCRYPTION_KEY=
# Only "gemini" for now. Leave empty to send nothing to any AI service.
CONSULTATIONS_TRANSCRIPTION_PROVIDER=
CONSULTATIONS_TRANSCRIPTION_MODEL=
# Model that drafts the note from the transcript; defaults to GEMINI_MODEL.
CONSULTATIONS_NOTE_MODEL=
# The privacy review, in your own words: WHO reviewed the provider's data handling and terms, WHEN, and what was decided
# (for example: "Reviewed by Dr A. Shah and the clinic's data lead on 2026-11-02: paid tier, no training on our data, ticket 123").
CONSULTATIONS_PROVIDER_REVIEW=
# Where the provider processes the data (for example: "Google Cloud, asia-south1 (Mumbai)").
CONSULTATIONS_PROVIDER_REGION=
# Longest recording, in minutes (default 45). Raise it only after testing recordings of that length: the speech service writes the whole
# transcript in one answer, which has an output limit, and Gujarati uses many more tokens per word than English.
CONSULTATIONS_MAX_MINUTES=45
# The most recorded audio ONE workspace may hold, in GB (default 25). Recordings are kept until deleted, and all workspaces share this
# server's disk, so one clinic must not be able to fill it. When a workspace reaches it, doctors are told to delete old recordings.
CONSULTATIONS_MAX_STORAGE_GB=25
# Largest recording the server accepts, in MB (default 120).
CONSULTATIONS_MAX_AUDIO_MB=120
# Where recordings are stored for now: a private folder on THIS server (each part is sealed). Default: DATA_DIR/consultation-audio.
# This is for the pilot with consented samples; use real cloud object storage before real patients (see the README).
CONSULTATIONS_AUDIO_DIR=
# Run the background worker inside this server process (default true).
CONSULTATIONS_WORKER=true

# ── First owner (workspace bootstrap) ──────────────────────────────────────
# At startup this account is created (if the address has no account yet) and becomes the OWNER of the
# "Default workspace" — the workspace that adopted every document, chat and integration that existed before
# organizations — as long as that workspace has no owner. It also becomes platform administrator (global AI
# settings and feature flags) if there is none yet. Registration is invite-only: invite people in Settings → Team.
# The password needs at least 4 characters and is only used to create the account; it never overwrites an
# existing account's password, so you can remove these lines once the owner exists.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=

# ── Sign-in, sessions and invitations ───────────────────────────────────────
# How long a sign-in lasts (hours).
AUTH_SESSION_HOURS=24
# How long an invitation link stays valid (hours; default 168 = 7 days).
INVITE_TTL_HOURS=168
# How long the temporary password the Super Admin hands to a new Customer Admin works (hours; default 72).
# The customer must replace it at their first sign-in; no email is involved.
TEMPORARY_PASSWORD_HOURS=72
# Number of reverse proxies in front of the app (0 = none, e.g. local use). Per-IP login throttling uses
# X-Forwarded-For ONLY when this is > 0, so a client cannot spoof its address. Per-account throttling is always on.
TRUSTED_PROXY_HOPS=0

# ── Demo account (optional; application login only — NOT an AI API key) ────
# The demo exists ONLY when DEMO_USER_PASSWORD is set (there is no built-in password). It signs in to its own
# separate "Demo workspace" and can never see a customer's data. Leave empty on production deployments.
DEMO_USER_EMAIL=demo@knowledgebase.ai
DEMO_USER_PASSWORD=
# true shows the demo credentials and the "Use Demo Account" button on the login page (default: hidden).
DEMO_SHOW_CREDENTIALS=false

# ── Sync Integrations (optional) ───────────────────────────────────────────
# Public base URL of this app; OAuth redirect URIs are built from it.
APP_BASE_URL=http://localhost:3000
# 32-byte key (base64) used to encrypt OAuth tokens at rest. Required for Google Drive / OneDrive.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=
# Google Drive — Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Enable the Google Drive API. Redirect URI: {APP_BASE_URL}/api/integrations/google-drive/callback
# Scope requested: https://www.googleapis.com/auth/drive.readonly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OneDrive — Microsoft Entra admin center → App registrations (platform: Web).
# Redirect URI: {APP_BASE_URL}/api/integrations/onedrive/callback
# Delegated permissions: offline_access, Files.Read, User.Read
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# common (work + personal accounts), consumers, organizations, or a tenant ID
MICROSOFT_OAUTH_TENANT=common
